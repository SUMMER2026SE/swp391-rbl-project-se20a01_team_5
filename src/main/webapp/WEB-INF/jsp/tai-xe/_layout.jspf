<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<style>
body { font-family: Arial, sans-serif; margin: 32px; color: #1f2937; }
nav { margin-bottom: 24px; display: flex; gap: 12px; flex-wrap: wrap; }
nav a, .button { background: #0f766e; color: white; padding: 8px 12px; border-radius: 6px; text-decoration: none; border: 0; cursor: pointer; }
a { color: #0f766e; }
table { border-collapse: collapse; width: 100%; margin-top: 16px; }
th, td { border: 1px solid #d1d5db; padding: 8px; text-align: left; }
th { background: #f3f4f6; }
form { max-width: 520px; display: grid; gap: 12px; }
label { display: grid; gap: 4px; font-weight: 600; }
input { padding: 8px; border: 1px solid #d1d5db; border-radius: 6px; }
.panel { border: 1px solid #d1d5db; border-radius: 8px; padding: 16px; margin-top: 16px; }
.muted { color: #6b7280; }
</style>
